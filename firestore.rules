rules_version = '2';

// Flex Smart Queue
// - Anyone signed in (guests included) can read a squad if they have its link.
// - Each player can only create/edit/delete their own entry.
// - Only the captain runs drafts, logs results, sets the starting 5, changes settings,
//   adds people by name, removes players, deletes games or deletes the squad.
// - A player may add themselves to the starting 5 when joining (if there's room) and take themselves out when leaving.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function squadPath(sid) { return /databases/$(database)/documents/squads/$(sid); }
    function isCaptain(sid) { return signedIn() && get(squadPath(sid)).data.captain == request.auth.uid; }
    // a non-captain may only add or remove their own id in the starting 5, nothing else
    function selfOnlyLineupChange() {
      let before = resource == null ? [] : resource.data.get('active', []);
      let after = request.resource.data.get('active', []);
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return signedIn()
        && after.size() <= 5
        && request.resource.data.get('draft', null) == (resource == null ? null : resource.data.get('draft', null))
        && ((added == [request.auth.uid].toSet() && removed.size() == 0)
          || (removed == [request.auth.uid].toSet() && added.size() == 0));
    }
    function validPlayer() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.prefs is list && d.prefs.size() == 5
        && d.avoid is list && d.avoid.size() <= 5;
    }

    match /squads/{sid} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.captain == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24;
      allow update: if isCaptain(sid) && request.resource.data.captain == resource.data.captain;
      allow delete: if isCaptain(sid);

      match /players/{pid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && exists(squadPath(sid)) && validPlayer()
          && (pid == request.auth.uid || (isCaptain(sid) && pid.matches('m-.*')));
        allow delete: if signedIn() && (pid == request.auth.uid || isCaptain(sid));
      }

      match /games/{gid} {
        allow read: if signedIn();
        allow create, update, delete: if isCaptain(sid);
      }

      match /live/{docId} {
        allow read: if signedIn();
        allow create, update: if docId == 'draft' && (isCaptain(sid) || selfOnlyLineupChange());
        allow delete: if isCaptain(sid);
      }
    }
  }
}
